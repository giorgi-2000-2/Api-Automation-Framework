<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="simpleTestCases" parallel="methods" thread-count="10">

    <test name="Negative Flow Tests">
        <groups>
            <run>
                <include name="negative"/>
            </run>
        </groups>
        <classes>
            <class name="ge.gmikeladze.platzi.tests.CategoryTest"/>
            <class name="ge.gmikeladze.platzi.tests.ProductTest"/>
            <class name="ge.gmikeladze.platzi.tests.UserTest"/>
            <class name="ge.gmikeladze.platzi.tests.AuthTest"/>
        </classes>

    </test>

</suite>