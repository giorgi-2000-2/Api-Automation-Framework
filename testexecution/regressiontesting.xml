<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="simpleTestCases" parallel="methods" thread-count="20">

    <test name="Regression testing ">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="ge.gmikeladze.platzi.tests.CategoryTest"/>
            <class name="ge.gmikeladze.platzi.tests.ProductTest"/>
            <class name="ge.gmikeladze.platzi.tests.UserTest"/>
            <class name="ge.gmikeladze.platzi.tests.e2e.E2ETest"/>
        </classes>
    </test>

</suite>